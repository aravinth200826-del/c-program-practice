#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <string.h>
_
#define MAX 100 //Define maximum length of expression

// Define a stack that holds characters
typedef struct {
    char items[MAX];
    int top;
} CharStack;

// Stack Operations
void initStack(CharStack *s) { s->top = -1; }
bool isFull(CharStack *s) { return s->top == MAX - 1; }
bool isEmpty(CharStack *s) { return s->top == -1; }

void push(CharStack *s, char value) {
    if (!isFull(s)) {
        s->items[++s->top] = value;
    }
}

char pop(CharStack *s) {
    if (!isEmpty(s)) {
        return s->items[s->top--];
    }
    return '\0'; // Return a null character if empty
}

// Function to check if two characters are a matching pair
bool isMatchingPair(char character1, char character2) {
    if (character1 == '(' && character2 == ')') return true;
    else if (character1 == '{' && character2 == '}') return true;
    else if (character1 == '[' && character2 == ']') return true;
    else return false;
}

// Function to check if the whole expression is balanced
bool areParenthesesBalanced(char exp[]) {
    CharStack s;
    initStack(&s);

    // Loop through each character in the string
    for (int i = 0; i < strlen(exp); i++) {
        
        // 1. If opening bracket, push to stack
        if (exp[i] == '{' || exp[i] == '(' || exp[i] == '[') {
            push(&s, exp[i]);
        } 
        // 2. If closing bracket, pop and check
        else if (exp[i] == '}' || exp[i] == ')' || exp[i] == ']') {
            
            // If stack is empty, there is no matching opening bracket
            if (isEmpty(&s)) {
                return false;
            }
            
            // Pop the top element and see if it matches
            char poppedChar = pop(&s);
            if (!isMatchingPair(poppedChar, exp[i])) {
                return false; 
            }
        }
    }
    
    // 3. If the stack is empty at the end, it's balanced!
    return isEmpty(&s); 
}

int main() {
    char expression1[] = "{[()]}"; // Balanced
    char expression2[] = "{[(])}"; // Not Balanced
    char expression3[] = "((()";   // Not Balanced

    // Test Expression 1
    if (areParenthesesBalanced(expression1)) 
        printf("%s is Balanced\n", expression1);
    else 
        printf("%s is Not Balanced\n", expression1);

    // Test Expression 2
    if (areParenthesesBalanced(expression2)) 
        printf("%s is Balanced\n", expression2);
    else 
        printf("%s is Not Balanced\n", expression2);

    // Test Expression 3
    if (areParenthesesBalanced(expression3)) 
        printf("%s is Balanced\n", expression3);
    else 
        printf("%s is Not Balanced\n", expression3);

    return 0;
}
